# AgentShield Environment Configuration (Sample)
# Copy to .env for local overrides

# Application
PROJECT_NAME="AgentShield Backend"
PROJECT_VERSION="1.0.0"

# Database (PostgreSQL in production, SQLite fallback for local test/dev)
# For local SQLite: sqlite:///./agentshield.db
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/agentshield
DATABASE_URL=sqlite:///./agentshield.db

# Live LLM Integration (Optional - disabled by default for deterministic test mode)
ENABLE_LIVE_LLM=false
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
