# AgentShield Environment Configuration
# Team Code Battalions | Visionet Techthon 2026

# Database Persistence (PostgreSQL for Docker, SQLite for local testing)
DATABASE_URL=postgresql://agentshield:agentshield_secure_pass@localhost:5432/agentshield
# Local SQLite fallback:
# DATABASE_URL=sqlite:///./agentshield.db

# Database Credentials (for docker-compose)
POSTGRES_USER=agentshield
POSTGRES_PASSWORD=agentshield_secure_pass
POSTGRES_DB=agentshield

# LLM Runtime Execution (false = deterministic fixtures, true = live Ollama)
AGENTSHIELD_LIVE_LLM=false
ENABLE_LIVE_LLM=false

# Security & Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Frontend API Base URL (defaults to same-origin relative '/api' proxy in Docker & dev)
VITE_API_BASE_URL=/api

# Cloudflare Turnstile CAPTCHA Configuration
# Generate keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Official test keys default for development & testing (always pass):
# Site Key: 1x00000000000000000000AA
# Secret:   1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# CAPTCHA Modes:
# - 'test'        : Uses Cloudflare test keys with live or dummy verification
# - 'production'  : Enforces real secret key verification against Cloudflare siteverify API
# - 'disabled'    : Bypasses CAPTCHA check (for isolated environments)
# - 'mock'        : Fast offline mocking for automated testing
CAPTCHA_MODE=test
TURNSTILE_EXPECTED_HOSTNAMES=localhost,127.0.0.1,testserver,example.com
TURNSTILE_TIMEOUT_SECONDS=5.0
